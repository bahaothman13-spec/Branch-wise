FLASK_DEBUG=True
SECRET_KEY=replace-with-your-secret-key

DB_HOST=your_database_host
DB_PORT=3306
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_NAME=your_database_name

# Optional full URL; when set, it takes precedence over the DB_* values above.
# Use mysql+mysqlconnector:// and percent-encode special characters in credentials.
# DATABASE_URL=mysql+mysqlconnector://your_database_user:your_database_password@your_database_host:3306/your_database_name
