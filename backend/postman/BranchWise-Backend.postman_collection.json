    {
      "name": "Inventory, Sales, and Product Requests",
      "item": [
        {
          "name": "Adjust stock",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
