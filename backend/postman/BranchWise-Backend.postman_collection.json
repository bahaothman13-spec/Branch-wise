{
  "info": {
    "name": "BranchWise Backend API",
    "description": "Select BranchWise Local. Log in before authenticated requests to capture the CSRF cookie. Stateful requests send X-CSRF-Token. Operational persistence is not installed by default, so valid database-backed actions return 501 until a persistent adapter is provided; the collection does not imply fake success.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:5000",
      "type": "string"
    },
    {
      "key": "csrf_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "request_key",
      "value": "request-001",
      "type": "string"
    },
    {
      "key": "branch_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "user_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "category_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "product_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "variant_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "request_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "sale_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "return_id",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health and Authentication",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/health",
            "description": "Public health check."
          }
        },
        {
          "name": "Register Owner",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/register",
            "description": "Registration needs AuthRepository; it creates no branch.",
            "body": {
              "mode": "raw",
              "raw": "{\"owner_name\":\"{{owner_name}}\",\"business_name\":\"{{business_name}}\",\"email\":\"{{email}}\",\"password\":\"{{password}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "description": "Needs account, session, and shared rate-limit adapters.",
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"{{email}}\",\"password\":\"{{password}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const token = pm.cookies.get('branchwise_csrf');",
                  "if (token) pm.environment.set('csrf_token', token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrf_token}}"
              }
            ],
            "url": "{{baseUrl}}/api/auth/logout",
            "description": "Requires a live session and CSRF.",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
