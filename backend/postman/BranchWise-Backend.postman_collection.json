              },
              {
                "key": "Idempotency-Key",
                "value": "{{request_key}}"
              }
            ],
            "url": "{{baseUrl}}/api/branches/{{branch_id}}/inventory/adjustments",
            "description": "Set Idempotency-Key; append-only and atomic.",
            "body": {
              "mode": "raw",
              "raw": "{\"product_variant_id\":{{variant_id}},\"direction\":\"INCREASE\",\"quantity\":3,\"reason\":\"Count correction\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
